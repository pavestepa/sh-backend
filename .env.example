# DEVELOPMENT environment.
# Copy this file to `.env` (Prisma's CLI and Prisma Client both hardcode
# that filename, so local dev deliberately keeps using bare `.env` rather
# than a suffixed one). See README §4 for how TEST and PROD differ.

# --- App ---
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:19006,http://localhost:8081
# No reverse proxy in front of the API locally.
TRUST_PROXY=false

# --- Database ---
DATABASE_URL=postgresql://sh:sh@localhost:5432/sh_backend?schema=public

# --- Auth / JWT ---
# openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- OTP ---
# Server-side pepper mixed into the OTP hash. Not a substitute for DB security.
OTP_HASH_PEPPER=dev-otp-pepper-change-me
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_PHONE_PER_HOUR=5
OTP_MAX_REQUESTS_PER_IP_PER_HOUR=20

# SMS provider: "mock" logs the OTP instead of sending a real SMS.
SMS_PROVIDER=mock

# --- Object storage (S3-compatible: Cloudflare R2 in prod, MinIO in dev) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=sh-backend-dev
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
# MinIO needs path-style URLs; R2/AWS should use virtual-hosted style (false).
STORAGE_FORCE_PATH_STYLE=true
STORAGE_UPLOAD_URL_TTL_SECONDS=300
STORAGE_DOWNLOAD_URL_TTL_SECONDS=600

# --- Background jobs (pg-boss uses DATABASE_URL) ---
JOBS_SCHEMA=pgboss

# --- Geo ---
# Default + max search radius, meters.
ORDERS_DEFAULT_SEARCH_RADIUS_M=5000
ORDERS_MAX_SEARCH_RADIUS_M=30000
