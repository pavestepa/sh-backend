# PRODUCTION environment template. Contains no real secrets — it exists to
# document which variables production needs, not to be copied to `.env` and
# filled in.
#
# In real deployment, these should be injected directly as process
# environment variables by the hosting platform's secret manager (Fly.io
# secrets, Render env vars, Docker/K8s secrets, etc.) — never committed as a
# file. If your platform genuinely only supports file-based config, copy
# this to `.env.production` (gitignored) and run
# `dotenv -e .env.production -- node dist/main`, but a real secret manager
# is preferable.
#
# validateEnv() (src/config/env.validation.ts) refuses to boot in
# production if JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, OTP_HASH_PEPPER, or
# the STORAGE_* credentials still hold one of the placeholder values from
# .env.example/.env.test — so copy-pasting those into prod by mistake fails
# fast at startup instead of silently shipping a guessable secret.

# --- App ---
NODE_ENV=production
PORT=3000
# Real origins only — no localhost.
CORS_ORIGINS=https://app.example.com
# Almost always true in production: the API sits behind a load balancer,
# ingress, or CDN, and needs X-Forwarded-For to see the real client IP
# (used by the OTP per-IP rate limiter and request logging).
TRUST_PROXY=true

# --- Database ---
# Managed Postgres with the postgis extension available (e.g. RDS,
# Cloud SQL, Supabase, Neon). sslmode=require unless the provider handles
# TLS at the network layer.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require

# --- Auth / JWT ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- OTP ---
OTP_HASH_PEPPER=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_PHONE_PER_HOUR=5
OTP_MAX_REQUESTS_PER_IP_PER_HOUR=20

# No real provider is implemented yet (see README §14) — only "mock", which
# logs the OTP instead of sending an SMS. Wiring a real provider means
# adding a class that implements SmsProvider (src/auth/sms) and switching
# the binding in SmsModule; until then, production boots with a loud
# startup warning rather than pretending SMS delivery works.
SMS_PROVIDER=mock

# --- Object storage (Cloudflare R2) ---
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=sh-backend-prod
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# R2 uses virtual-hosted style, not path style.
STORAGE_FORCE_PATH_STYLE=false
STORAGE_UPLOAD_URL_TTL_SECONDS=300
STORAGE_DOWNLOAD_URL_TTL_SECONDS=600

# --- Background jobs (pg-boss uses DATABASE_URL) ---
JOBS_SCHEMA=pgboss

# --- Geo ---
ORDERS_DEFAULT_SEARCH_RADIUS_M=5000
ORDERS_MAX_SEARCH_RADIUS_M=30000
