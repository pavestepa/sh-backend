# Config used for automated tests (NODE_ENV=test). Points at a dedicated
# test database and relaxes OTP throttling — the real per-phone/per-IP
# limits in .env.example are correct for production but would make a test
# suite that registers many users fail spuriously.
NODE_ENV=test
PORT=3001
CORS_ORIGINS=http://localhost:19006
TRUST_PROXY=false

DATABASE_URL=postgresql://sh:sh@localhost:5432/sh_backend_test?schema=public

JWT_ACCESS_SECRET=test-access-secret
JWT_REFRESH_SECRET=test-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OTP_HASH_PEPPER=test-otp-pepper
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=0
OTP_MAX_REQUESTS_PER_PHONE_PER_HOUR=1000
OTP_MAX_REQUESTS_PER_IP_PER_HOUR=1000

SMS_PROVIDER=mock

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=sh-backend-dev
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_UPLOAD_URL_TTL_SECONDS=300
STORAGE_DOWNLOAD_URL_TTL_SECONDS=600

JOBS_SCHEMA=pgboss_test

ORDERS_DEFAULT_SEARCH_RADIUS_M=5000
ORDERS_MAX_SEARCH_RADIUS_M=30000
